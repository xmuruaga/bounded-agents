# ============================================================
# AgentDojo-APC Experiment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Provider: "bedrock" or "anthropic" ---
LLM_PROVIDER=bedrock

# --- Model ID ---
LLM_MODEL=eu.anthropic.claude-sonnet-4-6

# --- AWS Bedrock settings ---
AWS_DEFAULT_REGION=eu-central-1
AWS_BEARER_TOKEN_BEDROCK=

# --- Anthropic API settings (only if LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Network / SSL ---
# Leave as "true". Only set to "false" if you are behind a TLS-intercepting
# proxy and understand that this disables certificate verification.
SSL_VERIFY=true

# --- Optional: offline mode ---
# Uncomment if your environment blocks outbound calls to the Hugging Face hub.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
